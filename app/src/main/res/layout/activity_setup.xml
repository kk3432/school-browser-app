<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="horizontal">

    <!-- 左侧品牌区：40% -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.40"
        android:background="@drawable/bg_brand_gradient"
        android:padding="@dimen/space_6">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="@dimen/brand_panel_size"
                android:layout_height="@dimen/brand_panel_size"
                android:background="@drawable/bg_logo_panel">

                <ImageView
                    android:layout_width="@dimen/brand_icon_size"
                    android:layout_height="@dimen/brand_icon_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_school"
                    app:tint="@color/on_primary" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/text_display" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:letterSpacing="0.08"
                android:text="@string/setup_brand_en"
                android:textColor="@color/white_40"
                android:textSize="@dimen/text_micro" />

            <View
                android:layout_width="@dimen/brand_rule_width"
                android:layout_height="@dimen/brand_rule_height"
                android:layout_marginTop="@dimen/space_4"
                android:background="@color/white_40" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/setup_brand_subtitle"
                android:textColor="@color/on_primary"
                android:textSize="@dimen/text_body_sm" />

        </LinearLayout>

    </FrameLayout>

    <!-- 右侧配置区：60% -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.60"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_6"
            android:paddingTop="@dimen/space_5"
            android:paddingEnd="@dimen/space_6"
            android:paddingBottom="@dimen/space_5">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/setup_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="@dimen/login_card_radius"
                app:cardElevation="@dimen/elevation_card"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="@dimen/hairline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_4">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/setup_title"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/text_title_lg" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/setup_required"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/text_caption" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_base_url"
                        style="@style/Widget.Campus.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        app:startIconDrawable="@drawable/ic_link">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_base_url"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/pin_input_height"
                            android:hint="@string/setup_hint"
                            android:imeOptions="actionGo"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textSize="@dimen/text_body_sm" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btn_connect"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/setup_connect" />

                    <Button
                        android:id="@+id/btn_scan"
                        style="@style/Widget.Campus.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="@string/setup_scan"
                        app:icon="@drawable/ic_scan"
                        app:iconTint="@color/nav_icon" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progress"
                            android:layout_width="@dimen/icon_24"
                            android:layout_height="@dimen/icon_24"
                            android:layout_gravity="center_horizontal"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/primary" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:gravity="center"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/text_caption" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
