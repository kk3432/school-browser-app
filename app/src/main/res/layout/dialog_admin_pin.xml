<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/pin_dialog_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_1">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_pin"
        style="@style/Widget.Campus.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pin_hint"
        app:endIconMode="password_toggle"
        app:startIconDrawable="@drawable/ic_lock">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_pin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/pin_input_height"
            android:digits="0123456789"
            android:imeOptions="actionDone"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:singleLine="true"
            android:textSize="@dimen/text_subtitle" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_pin_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/pin_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="@dimen/icon_24"
        android:layout_height="@dimen/icon_24"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_2"
        android:indeterminate="true"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/pin_confirm" />

</LinearLayout>
