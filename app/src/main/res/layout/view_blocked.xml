<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_6"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="@dimen/error_illustration"
        android:layout_height="@dimen/error_illustration"
        android:background="@drawable/bg_warning_circle">

        <ImageView
            android:layout_width="@dimen/error_icon_size"
            android:layout_height="@dimen/error_icon_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_lock"
            app:tint="@color/warning" />

    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:fontFamily="sans-serif-medium"
        android:text="@string/blocked_title"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/text_title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center"
        android:text="@string/blocked_text"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/text_body_sm" />

    <TextView
        android:id="@+id/tv_blocked_url"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:background="@drawable/bg_url_chip"
        android:ellipsize="middle"
        android:maxWidth="@dimen/error_url_max_width"
        android:paddingStart="@dimen/space_3"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/space_3"
        android:paddingBottom="@dimen/space_1"
        android:singleLine="true"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_caption" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_5"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_blocked_home"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:text="@string/back_home" />

        <Button
            android:id="@+id/btn_blocked_reload"
            style="@style/Widget.Campus.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginStart="@dimen/space_3"
            android:text="@string/blocked_reload" />

    </LinearLayout>

</LinearLayout>
